    }
  },
  "Outputs": {
    "Domain": {
      "Value": {
        "Fn::GetAtt": [
          "Distribution",
          "DomainName"
        ]
      }
    },
    "DistributionId": {
      "Value": {
        "Ref": "Distribution"
      }
    },
    "Table": {
      "Value": {
        "Ref": "State"
      }
    },
    "FunctionName": {
      "Value": {
        "Ref": "Function"
      }
    },
    "OriginUrl": {
      "Value": {
        "Fn::GetAtt": [
          "FunctionUrl",
          "FunctionUrl"
        ]
      }
    },
    "AdminDomain": {
      "Value": {
        "Fn::GetAtt": [
          "AdminDistribution",
          "DomainName"
        ]
      }
    },
    "AdminDistributionId": {
      "Value": {
        "Ref": "AdminDistribution"
      }
    },
    "BrowserDomain1": {
      "Value": {
        "Fn::GetAtt": [
          "BrowserDistribution1",
          "DomainName"
        ]
      }
    },
    "BrowserDistributionId1": {
      "Value": {
        "Ref": "BrowserDistribution1"
      }
    },
    "BrowserDomain2": {
      "Value": {
        "Fn::GetAtt": [
          "BrowserDistribution2",
          "DomainName"
        ]
      }
    },
    "BrowserDistributionId2": {
      "Value": {
        "Ref": "BrowserDistribution2"
      }
    },
    "BrowserDomain3": {
      "Value": {
        "Fn::GetAtt": [
          "BrowserDistribution3",
          "DomainName"
        ]
      }
    },
    "BrowserDistributionId3": {
      "Value": {
        "Ref": "BrowserDistribution3"
      }
    },
    "BrowserDomain4": {
