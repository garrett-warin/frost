# Frosty local API configuration
# Get a Groq key on the Free plan at https://console.groq.com/keys
# Paste it between the quotes below. Do not put this file in public/ or commit it.
# One key powers all models in the picker. Restart npm start after edits.
FROST_AI_PROVIDER="groq"
GROQ_API_KEY=""

# Comma-separated approved Groq model IDs. Qwen is a preview model with images.
# Keep the Groq account on the Free plan. Paid account keys can incur charges.
# Checked against the provider catalog on 2026-10-23; availability can change.
FROST_AI_MODELS="openai/gpt-oss-20b,openai/gpt-oss-120b,qwen/qwen3.8-27b"

# Optional local port; remove this line to use Frost's default 3100.
PORT=3104
